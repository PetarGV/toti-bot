# Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_discord_server_id_here

# Travian
TRAVIAN_SERVER_URL=https://ts2.x1.international.travian.com

# Bot config
MAP_FETCH_HOUR=6
DEF_ROLE_NAME=def-crew
LOCALE=en
BOT_FOOTER=Travian Alliance Bot

# Feature gating (optional) — for running a second, trimmed-down bot instance
# against a different guild. Leave unset to enable every feature (default).
# Comma-separated feature keys: scout, resources, map, defense, offense,
# timer, status, profile, leaderboard, roles, general, onboarding.
# Example for a scout + resource-push only server:
# FEATURES=scout,resources,map

# Ops
LOG_LEVEL=info
LOG_RETAIN_DAYS=14
HEALTH_PORT=8080
BACKUP_HOUR=3
BACKUP_RETAIN_DAYS=7